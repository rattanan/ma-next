generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  ARCHIVED
}
enum AuditResult {
  SUCCESS
  FAILED
}
enum LoginEventType {
  LOGIN
  LOGOUT
  SESSION
}
enum LoginStatus {
  SUCCESS
  FAILED
  LOCKED
  LOGOUT
  SESSION_EXPIRED
}
enum ScopeType {
  GLOBAL
  ORGANIZATION
  SITE
  DEPARTMENT
}
enum AttachmentDriver {
  LOCAL
  S3
  AZURE
}
enum NotificationChannel {
  IN_APP
  EMAIL
}
enum NotificationRecipientStatus {
  UNREAD
  READ
  ARCHIVED
}
enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum AssetStatus {
  ACTIVE
  OFFLINE
  RESERVED
  INACTIVE
  RETIRED
}
enum AssetStructureLevel {
  SYSTEM
  EQUIPMENT
  COMPONENT
}
enum AssetCustomFieldType {
  STRING
  NUMBER
  ARRAY
  DATE
}
enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum MaintenanceSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}
enum EquipmentOperatingStatus {
  RUNNING
  STOPPED
  DEGRADED
  UNKNOWN
}
enum MaintenanceNotificationType {
  CORRECTIVE
  BREAKDOWN
  INSPECTION
}
enum MaintenanceNotificationStatus {
  NEW
  APPROVED
  BACKLOG
  REJECTED
  COMPLETED
}
enum NotificationDecision {
  APPROVED
  BACKLOG
  REJECTED
}
enum WorkOrderStatus {
  OPEN
  BACKLOG
  IN_PROGRESS
  COMPLETION_PENDING
  VERIFIED
  CLOSED
}
enum WorkOrderSourceType {
  MANUAL
  NOTIFICATION
  PREVENTIVE_EVENT
  SHUTDOWN_TASK
  IMPORT
}
enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
  SHUTDOWN
  OTHER_ASSIGNMENT
}
enum WorkOrderBacklogScope {
  WORK_ORDER
  JOB_STEP
}
enum WorkOrderToolLoanStatus {
  PLANNED
  ISSUED
  RETURNED
  CANCELLED
}
enum WorkTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}
enum WorkTaskKind {
  JOB_STEP
  CHECKLIST
}
enum VerificationDecision {
  VERIFIED
  RETURNED
}

model User {
  id                         String            @id @default(uuid()) @db.VarChar(36)
  fullName                   String            @map("full_name") @db.VarChar(160)
  username                   String            @unique(map: "users_username_uq") @db.VarChar(80)
  email                      String            @unique(map: "users_email_uq") @db.VarChar(190)
  passwordHash               String            @map("password_hash") @db.VarChar(255)
  legacyRole                 String            @default("VIEWER") @map("role") @db.VarChar(40)
  status                     UserStatus        @default(ACTIVE)
  adminNotes                 String?           @map("admin_notes") @db.Text
  failedLoginAttempts        Int               @default(0) @map("failed_login_attempts")
  failedLoginWindowStartedAt DateTime?         @map("failed_login_window_started_at") @db.DateTime(3)
  lockedUntil                DateTime?         @map("locked_until") @db.DateTime(3)
  mustChangePassword         Boolean           @default(true) @map("must_change_password")
  lastLoginAt                DateTime?         @map("last_login_at") @db.DateTime(3)
  passwordChangedAt          DateTime?         @map("password_changed_at") @db.DateTime(3)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy                  String?           @map("created_by") @db.VarChar(36)
  updatedBy                  String?           @map("updated_by") @db.VarChar(36)
  archivedAt                 DateTime?         @map("archived_at") @db.DateTime(3)
  sessions                   Session[]
  passwordHistory            PasswordHistory[]
  roles                      UserRole[]
  notificationRecipients     NotificationRecipient[]

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.VarChar(36)
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.Text
  system      Boolean          @default(false)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.VarChar(36)
  code        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(160)
  description String?          @db.Text
  category    String           @db.VarChar(80)
  roles       RolePermission[]

  @@index([category])
  @@map("permissions")
}

model UserRole {
  id             String       @id @default(uuid()) @db.VarChar(36)
  userId         String       @map("user_id") @db.VarChar(36)
  roleId         String       @map("role_id") @db.VarChar(36)
  scopeType      ScopeType    @default(GLOBAL) @map("scope_type")
  organizationId String?      @map("organization_id") @db.VarChar(36)
  siteId         String?      @map("site_id") @db.VarChar(36)
  departmentId   String?      @map("department_id") @db.VarChar(36)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, organizationId, siteId, departmentId], map: "user_roles_scope_uq")
  @@index([userId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(36)
  permissionId String     @map("permission_id") @db.VarChar(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(uuid()) @db.VarChar(36)
  userId           String    @map("user_id") @db.VarChar(36)
  sessionTokenHash String    @unique(map: "sessions_token_uq") @map("session_token_hash") @db.VarChar(64)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.Text
  lastActiveAt     DateTime  @map("last_active_at") @db.DateTime(3)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_idx")
  @@index([expiresAt], map: "sessions_expires_idx")
  @@map("sessions")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt], map: "password_history_user_idx")
  @@map("password_history")
}

model LoginHistory {
  id              String         @id @default(uuid()) @db.VarChar(36)
  userId          String?        @map("user_id") @db.VarChar(36)
  loginIdentifier String         @map("login_identifier") @db.VarChar(190)
  eventType       LoginEventType @map("event_type")
  status          LoginStatus
  ipAddress       String?        @map("ip_address") @db.VarChar(64)
  userAgent       String?        @map("user_agent") @db.Text
  browser         String?        @db.VarChar(80)
  operatingSystem String?        @map("operating_system") @db.VarChar(80)
  deviceType      String?        @map("device_type") @db.VarChar(40)
  failureReason   String?        @map("failure_reason") @db.VarChar(160)
  loggedInAt      DateTime?      @map("logged_in_at") @db.DateTime(3)
  loggedOutAt     DateTime?      @map("logged_out_at") @db.DateTime(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  @@index([userId], map: "login_history_user_idx")
  @@index([createdAt], map: "login_history_created_idx")
  @@index([status], map: "login_history_status_idx")
  @@map("login_history")
}

model LoginRateLimit {
  ipHash          String    @id @map("ip_hash") @db.VarChar(64)
  windowStartedAt DateTime  @map("window_started_at") @db.DateTime(3)
  attempts        Int       @default(0)
  blockedUntil    DateTime? @map("blocked_until") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  @@map("login_rate_limits")
}

model Organization {
  id          String       @id @default(uuid()) @db.VarChar(36)
  code        String       @unique @db.VarChar(40)
  name        String       @db.VarChar(160)
  description String?      @db.Text
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  sites       Site[]
  departments Department[]
  @@map("organizations")
}

model Site {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String       @map("organization_id") @db.VarChar(36)
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(160)
  timezone       String       @default("Asia/Bangkok") @db.VarChar(80)
  address        String?      @db.Text
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments    Department[]
  @@unique([organizationId, code])
  @@map("sites")
}

model Department {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String       @map("organization_id") @db.VarChar(36)
  siteId         String?      @map("site_id") @db.VarChar(36)
  parentId       String?      @map("parent_id") @db.VarChar(36)
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(160)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  parent         Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[] @relation("DepartmentTree")
  @@unique([organizationId, code])
  @@index([siteId])
  @@map("departments")
}

model MasterDataType {
  id          String            @id @default(uuid()) @db.VarChar(36)
  code        String            @unique @db.VarChar(80)
  name        String            @db.VarChar(160)
  description String?           @db.Text
  valueSchema String?           @map("value_schema") @db.LongText
  system      Boolean           @default(false)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  values      MasterDataValue[]
  @@map("master_data_types")
}

model MasterDataValue {
  id               String         @id @default(uuid()) @db.VarChar(36)
  masterDataTypeId String         @map("master_data_type_id") @db.VarChar(36)
  code             String         @db.VarChar(80)
  label            String         @db.VarChar(190)
  description      String?        @db.Text
  sortOrder        Int            @default(0) @map("sort_order")
  metadata         String?        @db.LongText
  active           Boolean        @default(true)
  validFrom        DateTime?      @map("valid_from") @db.DateTime(3)
  validTo          DateTime?      @map("valid_to") @db.DateTime(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  type             MasterDataType @relation(fields: [masterDataTypeId], references: [id], onDelete: Cascade)
  @@unique([masterDataTypeId, code])
  @@index([masterDataTypeId, active])
  @@map("master_data_values")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.VarChar(36)
  actorUserId    String?     @map("actor_user_id") @db.VarChar(36)
  actorName      String?     @map("actor_name") @db.VarChar(160)
  action         String      @db.VarChar(100)
  category       String      @db.VarChar(60)
  targetType     String?     @map("target_type") @db.VarChar(60)
  targetId       String?     @map("target_id") @db.VarChar(80)
  targetName     String?     @map("target_name") @db.VarChar(190)
  result         AuditResult
  description    String?     @db.Text
  previousValues String?     @map("previous_values") @db.LongText
  newValues      String?     @map("new_values") @db.LongText
  ipAddress      String?     @map("ip_address") @db.VarChar(64)
  userAgent      String?     @map("user_agent") @db.Text
  requestId      String      @map("request_id") @db.VarChar(36)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  @@index([actorUserId], map: "audit_actor_idx")
  @@index([action], map: "audit_action_idx")
  @@index([targetType, targetId], map: "audit_target_idx")
  @@index([createdAt], map: "audit_created_idx")
  @@map("audit_logs")
}

model Attachment {
  id           String           @id @default(uuid()) @db.VarChar(36)
  entityType   String           @map("entity_type") @db.VarChar(80)
  entityId     String           @map("entity_id") @db.VarChar(80)
  driver       AttachmentDriver @default(LOCAL)
  storageKey   String           @map("storage_key") @db.VarChar(500)
  originalName String           @map("original_name") @db.VarChar(255)
  contentType  String           @map("content_type") @db.VarChar(120)
  byteSize     Int              @map("byte_size")
  checksum     String?          @db.VarChar(128)
  uploadedBy   String           @map("uploaded_by") @db.VarChar(36)
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt    DateTime?        @map("deleted_at") @db.DateTime(3)
  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@map("attachments")
}

model Notification {
  id          String                  @id @default(uuid()) @db.VarChar(36)
  type        String                  @db.VarChar(80)
  title       String                  @db.VarChar(190)
  message     String                  @db.Text
  actionUrl   String?                 @map("action_url") @db.VarChar(500)
  channel     NotificationChannel     @default(IN_APP)
  sourceType  String?                 @map("source_type") @db.VarChar(80)
  sourceId    String?                 @map("source_id") @db.VarChar(80)
  createdBy   String?                 @map("created_by") @db.VarChar(36)
  createdAt   DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt   DateTime?               @map("expires_at") @db.DateTime(3)
  recipients  NotificationRecipient[]
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id             String                      @id @default(uuid()) @db.VarChar(36)
  notificationId String                      @map("notification_id") @db.VarChar(36)
  userId         String                      @map("user_id") @db.VarChar(36)
  status         NotificationRecipientStatus @default(UNREAD)
  readAt         DateTime?                   @map("read_at") @db.DateTime(3)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  notification   Notification                @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([notificationId, userId])
  @@index([userId, status])
  @@map("notification_recipients")
}

model AssetType {
  id String @id @default(uuid()) @db.VarChar(36)
  code String @unique @db.VarChar(40)
  name String @db.VarChar(120)
  description String? @db.Text
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String @map("created_by") @db.VarChar(36)
  updatedBy String @map("updated_by") @db.VarChar(36)
  @@map("asset_types")
}

model AssetCategory {
  id String @id @default(uuid()) @db.VarChar(36)
  code String @unique @db.VarChar(40)
  name String @db.VarChar(120)
  description String? @db.Text
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String @map("created_by") @db.VarChar(36)
  updatedBy String @map("updated_by") @db.VarChar(36)
  @@map("asset_categories")
}

model Asset {
  id String @id @default(uuid()) @db.VarChar(36)
  code String @unique @db.VarChar(60)
  name String @db.VarChar(160)
  description String? @db.Text
  assetTypeId String @map("asset_type_id") @db.VarChar(36)
  assetCategoryId String? @map("asset_category_id") @db.VarChar(36)
  parentAssetId String? @map("parent_asset_id") @db.VarChar(36)
  structureLevel AssetStructureLevel @default(EQUIPMENT) @map("structure_level")
  location String @db.VarChar(190)
  criticality AssetCriticality @default(MEDIUM)
  status AssetStatus @default(ACTIVE)
  ownerUserId String? @map("owner_user_id") @db.VarChar(36)
  contractId String? @map("contract_id") @db.VarChar(36)
  primaryImagePath String? @map("primary_image_path") @db.VarChar(500)
  unit String? @db.VarChar(45)
  serialNumber String? @map("serial_number") @db.VarChar(45)
  maintenanceInterval Int? @map("maintenance_interval")
  runningHourCode String? @map("running_hour_code") @db.VarChar(45)
  budgetId String? @map("budget_id") @db.VarChar(45)
  gpsCoordinates String? @map("gps_coordinates") @db.VarChar(90)
  costCenterLegacyId Int? @map("cost_center_legacy_id")
  budgetReferenceLegacyId Int? @map("budget_reference_legacy_id")
  inventoryLocationLegacyId Int? @map("inventory_location_legacy_id")
  inventoryLocationName String? @map("inventory_location_name") @db.VarChar(190)
  legacySourceId Int? @unique @map("legacy_source_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy String @map("created_by") @db.VarChar(36)
  updatedBy String @map("updated_by") @db.VarChar(36)
  @@index([status])
  @@index([assetTypeId])
  @@index([parentAssetId])
  @@index([structureLevel])
  @@index([contractId])
  @@map("assets")
}

model Contract {
  id String @id @default(uuid()) @db.VarChar(36)
  code String @unique @db.VarChar(60)
  name String @db.VarChar(160)
  contractNumber String? @map("contract_number") @db.VarChar(60)
  description String? @db.Text
  vendorName String? @map("vendor_name") @db.VarChar(160)
  contactName String? @map("contact_name") @db.VarChar(120)
  telephone String? @db.VarChar(60)
  signedAt DateTime? @map("signed_at") @db.DateTime(3)
  startsAt DateTime? @map("starts_at") @db.DateTime(3)
  endsAt DateTime? @map("ends_at") @db.DateTime(3)
  amount Decimal? @db.Decimal(18, 2)
  terms String? @db.Text
  legacySourceId Int? @unique @map("legacy_source_id")
  @@map("contracts")
}

model AssetHierarchyLink {
  id String @id @default(uuid()) @db.VarChar(36)
  sequence Int @default(10)
  assetId String @map("asset_id") @db.VarChar(36)
  parentAssetId String? @map("parent_asset_id") @db.VarChar(36)
  rootAssetId String? @map("root_asset_id") @db.VarChar(36)
  enabled Boolean @default(true)
  quantity Decimal @default(1) @db.Decimal(14, 4)
  note String? @db.Text
  legacySourceId Int? @unique @map("legacy_source_id")
  @@index([parentAssetId, sequence])
  @@map("asset_hierarchy_links")
}

model SparePart {
  id String @id @default(uuid()) @db.VarChar(36)
  code String @unique @db.VarChar(80)
  name String @db.VarChar(190)
  description String? @db.Text
  unit String? @db.VarChar(45)
  availableQuantity Decimal? @map("available_quantity") @db.Decimal(14, 4)
  legacySourceId Int? @unique @map("legacy_source_id")
  @@map("spare_parts")
}

model AssetSparePart {
  id String @id @default(uuid()) @db.VarChar(36)
  sequence Int @default(10)
  assetId String @map("asset_id") @db.VarChar(36)
  sparePartId String @map("spare_part_id") @db.VarChar(36)
  enabled Boolean @default(true)
  requiredQuantity Decimal @default(1) @map("required_quantity") @db.Decimal(14, 4)
  note String? @db.Text
  legacySourceId Int? @unique @map("legacy_source_id")
  @@index([assetId, sequence])
  @@map("asset_spare_parts")
}

model AssetCustomFieldGroup {
  id String @id @default(uuid()) @db.VarChar(36)
  name String @unique @db.VarChar(80)
  sortOrder Int @default(10) @map("sort_order")
  legacySourceId Int? @unique @map("legacy_source_id")
  @@map("asset_custom_field_groups")
}

model AssetCustomFieldDefinition {
  id String @id @default(uuid()) @db.VarChar(36)
  assetCategoryId String? @map("asset_category_id") @db.VarChar(36)
  groupId String @map("group_id") @db.VarChar(36)
  name String @db.VarChar(80)
  label String @db.VarChar(190)
  description String? @db.Text
  fieldType AssetCustomFieldType @map("field_type")
  placeholder String? @db.VarChar(190)
  defaultValue String? @map("default_value") @db.VarChar(190)
  availableValues String? @map("available_values") @db.Text
  unit String? @db.VarChar(45)
  sortOrder Int @default(10) @map("sort_order")
  active Boolean @default(true)
  legacySourceId Int? @unique @map("legacy_source_id")
  @@index([assetCategoryId, groupId, sortOrder])
  @@map("asset_custom_field_definitions")
}

model AssetCustomFieldValue {
  id String @id @default(uuid()) @db.VarChar(36)
  assetId String @map("asset_id") @db.VarChar(36)
  definitionId String @map("definition_id") @db.VarChar(36)
  value String @db.VarChar(500)
  legacySourceId Int? @unique @map("legacy_source_id")
  @@unique([assetId, definitionId])
  @@map("asset_custom_field_values")
}

model AssetDocumentMetadata {
  attachmentId String @id @map("attachment_id") @db.VarChar(36)
  note String? @db.Text
  legacySourceId Int? @unique @map("legacy_source_id")
  @@map("asset_document_metadata")
}

model MaintenanceNotification {
  id String @id @default(uuid()) @db.VarChar(36)
  code String @unique @db.VarChar(60)
  assetId String @map("asset_id") @db.VarChar(36)
  title String @db.VarChar(190)
  description String @db.Text
  type MaintenanceNotificationType @default(CORRECTIVE)
  priority MaintenancePriority @default(MEDIUM)
  severity MaintenanceSeverity @default(MODERATE)
  equipmentOperatingStatus EquipmentOperatingStatus @default(UNKNOWN) @map("equipment_operating_status")
  status MaintenanceNotificationStatus @default(NEW)
  breakdown Boolean @default(false)
  requestedBy String @map("requested_by") @db.VarChar(36)
  departmentId String? @map("department_id") @db.VarChar(36)
  assignedPersonId String? @map("assigned_person_id") @db.VarChar(36)
