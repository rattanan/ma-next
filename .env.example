# Local development only. Never point development or tests at production.
DATABASE_URL="mysql://ma_next:local_password@127.0.0.1:3306/ma_next"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"
SESSION_COOKIE_SECURE="false"
ATTACHMENT_DRIVER="LOCAL"
ATTACHMENT_LOCAL_ROOT="./storage/attachments"
MAX_ATTACHMENT_BYTES="10485760"
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="ChangeMe!123456"
# TEST_DATABASE_URL must name a disposable, isolated database.
TEST_DATABASE_URL="mysql://ma_next_test:local_test_password@127.0.0.1:3306/ma_next_test"
